# ─────────────────────────────────────────────────────────────────────────────
# Ascend — environment variables
# Copy to `.env.local` for local dev. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public — safe to ship to the browser) ─────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key. RLS protects data; this is designed to be public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (SECRET — server only) ─────────────────────────────────────────
# Service role key. BYPASSES Row Level Security. NEVER expose to the client
# bundle, NEVER put in an n8n workflow reachable by untrusted webhook input.
# Used ONLY by the trusted server-side ranking cron / admin routes.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL of the deployment, used to build share-card + invite links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret guarding the ranking-compute endpoint so only the cron/n8n
# can trigger a recompute. Send as `Authorization: Bearer <this>`.
RANKING_JOB_SECRET=

# ── n8n / WhatsApp fan-out (Phase 2) ────────────────────────────────────────
# Webhook the ranking job POSTs the new rankings payload to. n8n then sends
# WhatsApp Business API messages and requests share-card generation.
N8N_RANKINGS_WEBHOOK_URL=
# Optional shared secret sent to n8n so it can verify the caller.
N8N_WEBHOOK_SECRET=

# ── Paystack (Phase 4) ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Premium plan code created in the Paystack dashboard (ZAR).
PAYSTACK_PREMIUM_PLAN_CODE=

# ── Claude API (Glow Up reports) ────────────────────────────────────────────
# SECRET — server only. Used by the glow-up report runner for vision analysis.
ANTHROPIC_API_KEY=
